[CLIPBOARD] for (UINT32 i = 0; i < count; i++)
{
    WCHAR* name = nullptr;
    UINT32 nameLength = 0;

    HRESULT hrName =
        ppDevices[i]->GetAllocatedString(
            MF_DEVSOURCE_ATTRIBUTE_FRIENDLY_NAME,
            &name,
            &nameLength
        );

    if (SUCCEEDED(hrName))
    {
        wprintf(L"Camera %u : %s\n", i, name);
        CoTaskMemFree(name);
    }
}
